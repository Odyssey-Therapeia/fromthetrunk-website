# ──────────────────────────────────────────────────────────────
# From the Trunk — Example environment variables (local development)
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# For the full production list see `.env.production.example`.
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# ─── Application ──────────────────────────────────────────────
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Auth (NextAuth) ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-32-char-string

# ─── Analytics ─────────────────────────────────────────────────
# Google Tag Manager container id — public, inlined into the client bundle.
# Leave blank to fully disable client analytics: no GTM, no GA4, and no consent
# banner render. GA4 is configured INSIDE the GTM container (no gtag.js in code,
# browser → GTM → GA4). Do NOT add NEXT_PUBLIC_GA4_MEASUREMENT_ID.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXXX"

# Server-side GA4 Measurement Protocol (server-only). Currently forwards
# `payment_completed` as the backend conversion (NOT yet a GA4 `purchase`).
# GA4_MEASUREMENT_ID is a public id; GA4_API_SECRET is a SERVER-ONLY secret —
# never expose it to the browser (no NEXT_PUBLIC_ prefix).
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
GA4_API_SECRET="replace-with-server-only-ga4-api-secret"

# ─── AI Virtual Drape (disabled by default) ──────────────────
# Server-only. Do not add NEXT_PUBLIC_ variants and do not enable until a
# controlled provider fidelity/cost/privacy review has passed.
FTT_TRYON_ENABLED=false
FTT_TRYON_ALLOWED_ORIGINS=https://fromthetrunk.shop,https://www.fromthetrunk.shop
FTT_TRYON_PROVIDER=google
FTT_TRYON_MODEL=gemini-3.1-flash-image
FTT_TRYON_GOOGLE_API_KEY=
FTT_TRYON_OPENAI_API_KEY=
FTT_TRYON_PROMPT_VERSION=nivi-v3
FTT_TRYON_ENGINE_VERSION=storefront-v1
FTT_TRYON_OUTPUT_VERSION=jpeg-1k-v1
FTT_TRYON_DISCLOSURE_VERSION=provider-disclosure-v1
FTT_PRIVACY_POLICY_VERSION=2026-08-ai-v1
FTT_TRYON_SESSION_SECRET=
FTT_TRYON_HMAC_SECRET=
FTT_TRYON_IP_HASH_SECRET=
FTT_TRYON_MONTHLY_LIMIT_MICRO_USD=
FTT_TRYON_PROVIDER_TIMEOUT_MS=210000

# Required for production try-on rate, lock, and concurrency enforcement.
# Existing Vercel KV_REST_API_URL / KV_REST_API_TOKEN aliases are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Immutable product-media derivatives (server-only; off by default) ───
# Backfill tooling requires explicit resource identities and a dedicated Blob
# token. Never expose these as NEXT_PUBLIC_ variables.
FTT_MEDIA_DERIVATIVE_PUBLISH_GUARD=0
FTT_MEDIA_DERIVATIVE_UPLOADS_ENABLED=0
FTT_MEDIA_DERIVATIVES_ACTIVE=0
FTT_MEDIA_EXECUTION_ENVIRONMENT=local
FTT_MEDIA_DATABASE_ID=
FTT_MEDIA_BLOB_STORE_ID=
FTT_MEDIA_DERIVATIVE_BLOB_TOKEN=
FTT_MEDIA_DERIVATIVE_DESTINATION_HOST=
