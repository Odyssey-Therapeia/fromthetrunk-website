# ──────────────────────────────────────────────────────────────
# From the Trunk — environment variables (local development)
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# Placeholders only: never commit a real secret to this file.
# For the deployed list see `.env.production.example`.
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
# Required. Neon/Postgres connection string.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# ─── Application origin ───────────────────────────────────────
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Auth (NextAuth) ──────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-32-char-string

# ─── Signed token secrets ─────────────────────────────────────
# lib/security/token-secrets.ts requires all six in production. In development
# they fall back to NEXTAUTH_SECRET / AUTH_SECRET / PAYLOAD_SECRET /
# ADMIN_API_SECRET, so they may stay blank locally.
RESERVATION_TOKEN_SECRET=
ORDER_ACCESS_TOKEN_SECRET=
EMAIL_VERIFICATION_TOKEN_SECRET=
PREVIEW_TOKEN_SECRET=
AUTH_OTP_SECRET=
AUTH_OTP_TOKEN_SECRET=

# ─── OAuth providers (optional locally) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ─── Razorpay (use TEST keys locally) ─────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Guard that refuses live keys outside production. Leave unset.
ALLOW_UNSAFE_LIVE_PAYMENTS=

# ─── Email ────────────────────────────────────────────────────
# Resend is the primary sender; SMTP is the fallback. With neither set,
# lib/email/send.ts logs the message instead of delivering it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=From the Trunk <hello@fromthetrunk.shop>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Comma-separated internal recipients for order notifications.
ORDER_NOTIFICATION_EMAILS=
FTT_ORDER_NOTIFICATION_EMAILS=

# ─── Cron, admin and debug ────────────────────────────────────
CRON_SECRET=generate-a-random-secret-for-cron
ADMIN_API_SECRET=generate-a-random-admin-secret
# Debug endpoints stay off unless both are set.
FTT_ENABLE_DEBUG_ENDPOINTS=0
FTT_DEBUG_TOKEN=

# ─── Rate limiting / locks (Upstash Redis) ────────────────────
# Optional locally; required for production rate, lock and concurrency limits.
# The Vercel KV_* aliases are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Commerce feature flags ───────────────────────────────────
FTT_FEATURE_INVENTORY_V2=1
FTT_FEATURE_GST_INCLUSIVE=0
FTT_FEATURE_BLOCKS_HOMEPAGE=0
# Launch pricing: shipping and GST are off; see lib/orders/order-pricing.ts.
NEXT_PUBLIC_FTT_ENABLE_GST=0
NEXT_PUBLIC_FTT_ENABLE_SHIPPING_CHARGES=0
NEXT_PUBLIC_FTT_GST_RATE=5
NEXT_PUBLIC_FTT_SHIPPING_STANDARD=0
NEXT_PUBLIC_FTT_SHIPPING_EXPRESS=0
NEXT_PUBLIC_FTT_SHIPPING_FREE_THRESHOLD=0

# ─── Drape Room / AI virtual drape (off by default) ───────────
# Server-only. Do not add NEXT_PUBLIC_ variants and do not enable until a
# controlled provider fidelity/cost/privacy review has passed.
FTT_TRYON_ENABLED=false
FTT_TRYON_ALLOWED_ORIGINS=http://localhost:3000
FTT_TRYON_PROVIDER=google
FTT_TRYON_MODEL=gemini-3.1-flash-image
FTT_TRYON_GOOGLE_API_KEY=
FTT_TRYON_OPENAI_API_KEY=
FTT_TRYON_PROMPT_VERSION=nivi-v3
FTT_TRYON_ENGINE_VERSION=storefront-v1
FTT_TRYON_OUTPUT_VERSION=jpeg-1k-v1
FTT_TRYON_DISCLOSURE_VERSION=provider-disclosure-v1
FTT_PRIVACY_POLICY_VERSION=2026-08-ai-v1
FTT_TRYON_SESSION_SECRET=
FTT_TRYON_HMAC_SECRET=
FTT_TRYON_IP_HASH_SECRET=
FTT_TRYON_MONTHLY_LIMIT_MICRO_USD=
FTT_TRYON_PROVIDER_TIMEOUT_MS=210000
# Drape Room launch banner copy: "launch" or "evergreen".
NEXT_PUBLIC_DRAPE_ANNOUNCEMENT_VARIANT=launch

# ─── Immutable product-media derivatives ──────────────────────
# Not required for ordinary Drape Room runtime. These belong to the backfill
# tooling only and are deliberately left unset here, so an ordinary local or
# deployed runtime never picks up a derivative resource identity by accident.
# To run a backfill, set them in that shell session, never in this file:
#   FTT_MEDIA_DERIVATIVES_ACTIVE, FTT_MEDIA_EXECUTION_ENVIRONMENT,
#   FTT_MEDIA_DATABASE_ID, FTT_MEDIA_BLOB_STORE_ID,
#   FTT_MEDIA_DERIVATIVE_BLOB_TOKEN, FTT_MEDIA_DERIVATIVE_DESTINATION_HOST,
#   FTT_MEDIA_DERIVATIVE_PUBLISH_GUARD, FTT_MEDIA_DERIVATIVE_UPLOADS_ENABLED,
#   FTT_MEDIA_SOURCE_HOSTS
# Never expose any of them as NEXT_PUBLIC_ variables.

# ─── Analytics ────────────────────────────────────────────────
# Google Tag Manager container id — public, inlined into the client bundle.
# Leave blank to fully disable client analytics: no GTM, no GA4, and no consent
# banner render. GA4 is configured INSIDE the GTM container (browser → GTM →
# GA4, no gtag.js in code). Do NOT add NEXT_PUBLIC_GA4_MEASUREMENT_ID.
NEXT_PUBLIC_GTM_ID=
# Server-side GA4 Measurement Protocol (server-only secret).
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Meta Pixel (browser). Public: inlined into the client bundle. Loads only
# after analytics consent is granted (components/analytics/analytics-gate.tsx),
# and sends PageView only — conversions stay server-side in the CAPI sink below.
# Must be the SAME pixel id as META_CAPI_PIXEL_ID, or Pixel and CAPI report to
# two different pixels.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-only).
META_CAPI_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CATALOG_ID=
META_SYSTEM_USER_TOKEN=
# Error tracking.
SENTRY_DSN=

# ─── Social / feeds ───────────────────────────────────────────
NEXT_PUBLIC_USE_LIVE_SOCIAL_FEED=0
BEHOLD_FEED_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=fromthetrunk
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fromthetrunk
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Token guarding the public product feed routes.
FEEDS_PUBLIC_TOKEN=

# ─── AI / embeddings ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=10000
# Storefront agent chat route.
ANTHROPIC_API_KEY=

# ─── Realtime (optional; falls back to polling) ───────────────
NEXT_PUBLIC_ELECTRIC_SHAPE_URL=

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
