# ──────────────────────────────────────────────────────────────
# From the Trunk — production environment variables
#
# Copy this list into the deployment platform (Vercel → Project → Settings →
# Environment Variables). Placeholders only: never commit a real secret here.
# For local development see `.env.example`.
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
# Required. Pooled Neon/Postgres connection string.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# ─── Application origin ───────────────────────────────────────
# Canonical production origin used by SEO metadata, sitemap, robots and
# llms.txt. The www host is canonical; the apex redirects to it.
SITE_URL=https://www.fromthetrunk.shop
NEXT_PUBLIC_SERVER_URL=https://www.fromthetrunk.shop

# ─── Auth (NextAuth) ──────────────────────────────────────────
NEXTAUTH_URL=https://www.fromthetrunk.shop
NEXTAUTH_SECRET=generate-a-random-32-char-string

# ─── Signed token secrets (all six REQUIRED in production) ────
# lib/security/token-secrets.ts refuses to start without these: the
# development fallbacks to NEXTAUTH_SECRET et al. apply only outside
# production. Generate a distinct random 32+ char value for each.
RESERVATION_TOKEN_SECRET=generate-a-random-32-char-string
ORDER_ACCESS_TOKEN_SECRET=generate-a-random-32-char-string
EMAIL_VERIFICATION_TOKEN_SECRET=generate-a-random-32-char-string
PREVIEW_TOKEN_SECRET=generate-a-random-32-char-string
AUTH_OTP_SECRET=generate-a-random-32-char-string
AUTH_OTP_TOKEN_SECRET=generate-a-random-32-char-string

# ─── OAuth providers ──────────────────────────────────────────
# At least one provider must be configured for social sign-in to work.
# Email OTP sign-in needs no provider credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ─── Razorpay payment gateway ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Escape hatch that lets live keys run outside production. Leave unset.
ALLOW_UNSAFE_LIVE_PAYMENTS=

# ─── Email ────────────────────────────────────────────────────
# Resend is the primary sender; SMTP is the fallback. Order, OTP, restock and
# tracking mail all route through lib/email/send.ts, so at least one of the
# two must be configured in production.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=From the Trunk <hello@fromthetrunk.shop>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Comma-separated internal recipients for new-order notifications.
ORDER_NOTIFICATION_EMAILS=hello@fromthetrunk.shop
FTT_ORDER_NOTIFICATION_EMAILS=

# ─── Cron, admin and debug ────────────────────────────────────
# Shared secret authenticating every /api/v2/cron/* endpoint. The scheduled
# jobs are declared in vercel.json.
CRON_SECRET=generate-a-random-secret-for-cron
ADMIN_API_SECRET=generate-a-random-admin-secret
# Debug endpoints stay off unless BOTH are set. Keep them unset in production.
FTT_ENABLE_DEBUG_ENDPOINTS=0
FTT_DEBUG_TOKEN=

# ─── Rate limiting / locks (Upstash Redis) ────────────────────
# Required in production for OTP rate limits, checkout locks and try-on
# concurrency. The Vercel KV_* aliases are also accepted.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Commerce feature flags ───────────────────────────────────
FTT_FEATURE_INVENTORY_V2=1
FTT_FEATURE_GST_INCLUSIVE=0
FTT_FEATURE_BLOCKS_HOMEPAGE=0
# Launch pricing: free shipping and no GST line; see lib/orders/order-pricing.ts.
NEXT_PUBLIC_FTT_ENABLE_GST=0
NEXT_PUBLIC_FTT_ENABLE_SHIPPING_CHARGES=0
NEXT_PUBLIC_FTT_GST_RATE=5
NEXT_PUBLIC_FTT_SHIPPING_STANDARD=0
NEXT_PUBLIC_FTT_SHIPPING_EXPRESS=0
NEXT_PUBLIC_FTT_SHIPPING_FREE_THRESHOLD=0

# ─── Drape Room / AI virtual drape (off by default) ───────────
# Server-only. Do not add NEXT_PUBLIC_ variants and do not enable until a
# controlled provider fidelity/cost/privacy review has passed.
FTT_TRYON_ENABLED=false
FTT_TRYON_ALLOWED_ORIGINS=https://fromthetrunk.shop,https://www.fromthetrunk.shop
FTT_TRYON_PROVIDER=google
FTT_TRYON_MODEL=gemini-3.1-flash-image
FTT_TRYON_GOOGLE_API_KEY=
FTT_TRYON_OPENAI_API_KEY=
FTT_TRYON_PROMPT_VERSION=nivi-v3
FTT_TRYON_ENGINE_VERSION=storefront-v1
FTT_TRYON_OUTPUT_VERSION=jpeg-1k-v1
FTT_TRYON_DISCLOSURE_VERSION=provider-disclosure-v1
FTT_PRIVACY_POLICY_VERSION=2026-08-ai-v1
FTT_TRYON_SESSION_SECRET=
FTT_TRYON_HMAC_SECRET=
FTT_TRYON_IP_HASH_SECRET=
FTT_TRYON_MONTHLY_LIMIT_MICRO_USD=
FTT_TRYON_PROVIDER_TIMEOUT_MS=210000
# Drape Room launch banner copy: "launch" or "evergreen".
NEXT_PUBLIC_DRAPE_ANNOUNCEMENT_VARIANT=launch

# ─── Immutable product-media derivatives ──────────────────────
# Not required for ordinary Drape Room runtime. These belong to the backfill
# tooling only and are deliberately left unset here, so a deployed runtime
# never picks up a derivative resource identity by accident.
# To run a backfill, set them in that shell session, never in this file:
#   FTT_MEDIA_DERIVATIVES_ACTIVE, FTT_MEDIA_EXECUTION_ENVIRONMENT,
#   FTT_MEDIA_DATABASE_ID, FTT_MEDIA_BLOB_STORE_ID,
#   FTT_MEDIA_DERIVATIVE_BLOB_TOKEN, FTT_MEDIA_DERIVATIVE_DESTINATION_HOST,
#   FTT_MEDIA_DERIVATIVE_PUBLISH_GUARD, FTT_MEDIA_DERIVATIVE_UPLOADS_ENABLED,
#   FTT_MEDIA_SOURCE_HOSTS
# Never expose any of them as NEXT_PUBLIC_ variables.

# ─── Analytics ────────────────────────────────────────────────
# Google Tag Manager container id. Public (inlined into the browser bundle).
# When unset, GTM/GA4 do not load at all and the consent banner never appears.
# GA4 is configured INSIDE the GTM container (browser → GTM → GA4, no gtag.js).
# Do NOT add NEXT_PUBLIC_GA4_MEASUREMENT_ID.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX
# Server-side GA4 Measurement Protocol. GA4_MEASUREMENT_ID is a public id;
# GA4_API_SECRET is SERVER-ONLY — never give it a NEXT_PUBLIC_ prefix.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=replace-with-server-only-ga4-api-secret
# Meta Pixel (browser). Public: inlined into the client bundle, so this is not
# a secret. Loads only after analytics consent is granted
# (components/analytics/analytics-gate.tsx) and sends PageView only —
# conversions stay server-side in the CAPI sink below. Keep this and
# META_CAPI_PIXEL_ID on the same pixel id.
NEXT_PUBLIC_META_PIXEL_ID=1368141865250071

# Meta Conversions API and catalogue sync (server-only).
META_CAPI_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CATALOG_ID=
META_SYSTEM_USER_TOKEN=
# Error tracking.
SENTRY_DSN=

# ─── Social / feeds ───────────────────────────────────────────
NEXT_PUBLIC_USE_LIVE_SOCIAL_FEED=0
BEHOLD_FEED_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=fromthetrunk
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fromthetrunk
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Token guarding the public product feed routes.
FEEDS_PUBLIC_TOKEN=generate-a-random-feed-token

# ─── AI / embeddings ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=10000
# Storefront agent chat route.
ANTHROPIC_API_KEY=

# ─── Realtime (optional; falls back to polling) ───────────────
NEXT_PUBLIC_ELECTRIC_SHAPE_URL=

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Reporting integrations (optional; scripts only) ──────────
# Used by the SEO/analytics reporting scripts, not by the storefront runtime.
GSC_PROPERTY=
GSC_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GA4_DATA_SA_JSON=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
